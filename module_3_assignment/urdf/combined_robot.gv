digraph G {
node [shape=box];
"chassis" [label="chassis"];
"base_link" [label="base_link"];
"link_1" [label="link_1"];
"link_2" [label="link_2"];
"gripper" [label="gripper"];
"finger_1" [label="finger_1"];
"finger_2" [label="finger_2"];
"left_steering" [label="left_steering"];
"front_left_wheel" [label="front_left_wheel"];
"right_steering" [label="right_steering"];
"front_right_wheel" [label="front_right_wheel"];
"rear_left_wheel" [label="rear_left_wheel"];
"rear_right_wheel" [label="rear_right_wheel"];
node [shape=ellipse, color=blue, fontcolor=blue];
"chassis" -> "connector_joint" [label="xyz: 0 0 0.1 \nrpy: 0 -0 0"]
"connector_joint" -> "base_link"
"base_link" -> "base_joint" [label="xyz: 0 0 0 \nrpy: 0 -0 0"]
"base_joint" -> "link_1"
"link_1" -> "joint_1" [label="xyz: 0 0 0.3 \nrpy: 0 -0 0"]
"joint_1" -> "link_2"
"link_2" -> "joint_2" [label="xyz: 0 0 0.3 \nrpy: 0 -0 0"]
"joint_2" -> "gripper"
"gripper" -> "joint_3" [label="xyz: 0.05 0 0.01 \nrpy: 0 -0 0"]
"joint_3" -> "finger_1"
"gripper" -> "joint_4" [label="xyz: -0.05 0 0.01 \nrpy: 0 -0 0"]
"joint_4" -> "finger_2"
"chassis" -> "front_left_steering_joint" [label="xyz: 0.4 0.3 -0.265 \nrpy: 0 -0 0"]
"front_left_steering_joint" -> "left_steering"
"left_steering" -> "front_left_wheel_joint" [label="xyz: 0 0 0 \nrpy: 0 -0 0"]
"front_left_wheel_joint" -> "front_left_wheel"
"chassis" -> "front_right_steering_joint" [label="xyz: 0.4 -0.3 -0.265 \nrpy: 0 -0 0"]
"front_right_steering_joint" -> "right_steering"
"right_steering" -> "front_right_wheel_joint" [label="xyz: 0 0 0 \nrpy: 0 -0 0"]
"front_right_wheel_joint" -> "front_right_wheel"
"chassis" -> "rear_left_drive_joint" [label="xyz: -0.4 0.3 -0.265 \nrpy: 0 -0 0"]
"rear_left_drive_joint" -> "rear_left_wheel"
"chassis" -> "rear_right_drive_joint" [label="xyz: -0.4 -0.3 -0.265 \nrpy: 0 -0 0"]
"rear_right_drive_joint" -> "rear_right_wheel"
}
