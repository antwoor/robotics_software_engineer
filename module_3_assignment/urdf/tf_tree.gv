"link_1" -> "joint_1" [label="xyz: 0 0 1.48 \nrpy: 0 -0 0"]
"joint_1" -> "link_2"
"link_2" -> "joint_2" [label="xyz: 0 0 1.48 \nrpy: 0 -0 0"]
"joint_2" -> "gripper"
}
