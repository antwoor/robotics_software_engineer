<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tf_tree">

    <xacro:macro name="manipulator" params="">
    <link name="base_link">

        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.3 0.3 0.1"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.3 0.3 0.1"/>
            </geometry>
        </collision>

        <!-- <inertial>
        <mass value="1.0"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial> -->

    </link>

    <link name="link_1">

        <visual>
            <origin xyz="0.0 0.0 0.18" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.06" length="0.3"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.06" length="0.3"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03"/>
        </inertial>

    </link>

    <link name="link_2">
        <visual>
            <origin xyz="0.0 0.0 0.18" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.06" length="0.3"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.06" length="0.3"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03"/>
        </inertial>
    </link>

    <link name="gripper">
        <visual>
            <origin xyz="0.0 0.0 0.07" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.3 0.06 0.06"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.3 0.06 0.06"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <link name="finger_1">
        <visual>
            <origin xyz="0.0 0.0 0.14" rpy="0.0 1.56 0.0"/>
            <geometry>
                <box size="0.1 0.06 0.06"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.3 0.06 0.06"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <link name="finger_2">
        <visual>
            <origin xyz="0.0 0.0 0.14" rpy="0.0 1.56 0.0"/>
            <geometry>
                <box size="0.1 0.06 0.06"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.3 0.06 0.06"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_joint" type="continuous">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="link_1"/>
        <axis xyz="0.0 0.0 1.0"/>
    </joint>

    <joint name="joint_1" type="revolute">
        <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
        <parent link="link_1"/>
        <child link="link_2"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="1.0" velocity="5.0"/>
    </joint>

    <joint name="joint_2" type="revolute">
        <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
        <parent link="link_2"/>
        <child link="gripper"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.14" upper="3.14" effort="1.0" velocity="5.0"/>
    </joint>

    <joint name="joint_3" type="prismatic">
        <origin xyz="0.05 0.0 0.01" rpy="0.0 0.0 0.0"/>
        <parent link="gripper"/>
        <child link="finger_1"/>
        <axis xyz="-1.0 0.0 0.0"/>
        <limit lower="-0.5" upper="0.01" effort="1.0" velocity="5.0"/>
    </joint>

    <joint name="joint_4" type="prismatic">
        <origin xyz="-0.05 0.0 0.01" rpy="0.0 0.0 0.0"/>
        <parent link="gripper"/>
        <child link="finger_2"/>
        <axis xyz="1.0 0.0 0.0"/>
        <limit lower="-0.5" upper="0.01" effort="1.0" velocity="5.0"/>
    </joint>
     </xacro:macro>
</robot>