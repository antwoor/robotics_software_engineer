<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robot">

    <xacro:macro name="mobile_robot" params="base_link">
    <!-- Базовая платформа -->
    <link name="${base_link}">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
        </collision>
    </link>

    <!-- Колеса -->
    <link name="wheel_left">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>
    </link>

    <link name="wheel_right">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>
    </link>

    <!-- Шарниры для колес -->
    <joint name="wheel_left_joint" type="continuous">
        <origin xyz="-0.3 0.2 0.1" rpy="0 0 0"/>
        <parent link="${base_link}"/>
        <child link="wheel_left"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="wheel_right_joint" type="continuous">
        <origin xyz="-0.3 -0.2 0.1" rpy="0 0 0"/>
        <parent link="${base_link}"/>
        <child link="wheel_right"/>
        <axis xyz="0 1 0"/>
    </joint>
    </xacro:macro>
</robot>
